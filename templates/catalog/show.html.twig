{% extends 'base.html.twig' %}

{% block title %}{{ movie.title }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <a href="{{ path('app_catalog') }}" class="btn btn-outline-secondary mb-4">
            Retour au catalogue
        </a>

        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                         style="height: 350px;">
                        <span class="text-white">Affiche indisponible</span>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <h1>{{ movie.title }}</h1>

                <p>
                    <span class="badge bg-primary">
                        {{ movie.category.name }}
                    </span>
                </p>

                <p>
                    <strong>Date de sortie :</strong>
                    {{ movie.releaseDate|date('d/m/Y') }}
                </p>

                <p>
                    <strong>Durée :</strong>
                    {{ movie.duration }} minutes
                </p>

                {% if movie.pressRating %}
                    <p>
                        <strong>Note presse :</strong>
                        {{ movie.pressRating }}/10
                    </p>
                {% endif %}

                {% if movie.synopsis %}
                    <h2 class="h5 mt-4">Synopsis</h2>
                    <p>{{ movie.synopsis }}</p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}