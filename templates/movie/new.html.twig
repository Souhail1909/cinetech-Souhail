{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Ajouter un film — CinéTech{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="mb-4">Ajouter un film</h1>

                        {{ form_start(form, {
                            'attr': {
                                'novalidate': 'novalidate'
                            }
                        }) }}

                            {{ form_errors(form) }}

                            {{ form_row(form.title) }}

                            {{ form_row(form.synopsis, {
                                'attr': {
                                    'rows': 5
                                }
                            }) }}

                            <div class="row">
                                <div class="col-md-6">
                                    {{ form_row(form.duration) }}
                                </div>

                                <div class="col-md-6">
                                    {{ form_row(form.releaseDate) }}
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    {{ form_row(form.pressRating) }}
                                </div>

                                <div class="col-md-6">
                                    {{ form_row(form.category) }}
                                </div>
                            </div>

                            {{ form_row(form.poster) }}

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <button type="submit" class="btn btn-primary">
                                    Enregistrer le film
                                </button>

                                <a
                                    href="{{ path('app_movie_index') }}"
                                    class="btn btn-outline-secondary"
                                >
                                    Annuler
                                </a>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}