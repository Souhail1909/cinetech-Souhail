{% extends 'base.html.twig' %}

{% block title %}{{ movie.title }} — CinéTech{% endblock %}

{% block body %}
    <div class="container py-5">
        <a href="{{ path('app_movie_index') }}" class="btn btn-outline-secondary mb-4">
            ← Retour au catalogue
        </a>

        <div class="card shadow-sm">
            <div class="card-body">
                <span class="badge bg-secondary mb-3">
                    {{ movie.category.name }}
                </span>

                <h1 class="mb-3">
                    {{ movie.title }}
                </h1>

                <p class="text-muted">
                    Sorti le {{ movie.releaseDate|date('d/m/Y') }}
                </p>

                <p>
                    <strong>Durée :</strong>
                    {{ movie.duration }} minutes
                </p>

                {% if movie.pressRating is not null %}
                    <p>
                        <strong>Note presse :</strong>
                        {{ movie.pressRating }}/5
                    </p>
                {% endif %}

                {% if movie.poster %}
                    <p>
                        <strong>Affiche :</strong>
                        <a href="{{ movie.poster }}" target="_blank" rel="noopener">
                            Voir l’affiche
                        </a>
                    </p>
                {% endif %}

                <h2 class="h5 mt-4">
                    Synopsis
                </h2>

                <p>
                    {{ movie.synopsis|default('Aucun synopsis disponible.') }}
                </p>

                <a
                    href="{{ path('app_movie_edit', { id: movie.id }) }}"
                    class="btn btn-warning mt-3"
                >
                    Modifier ce film
                </a>
            </div>
        </div>
    </div>
{% endblock %}