{% extends 'base.html.twig' %}

{% block title %}Catalogue — CinéTech{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Catalogue</h1>

            <a href="{{ path('app_movie_new') }}" class="btn btn-primary">
                Ajouter un film
            </a>
        </div>

        <div class="row g-4">
            {% for movie in movies %}
                <div class="col-md-6 col-lg-4">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary mb-2">
                                {{ movie.category.name }}
                            </span>

                            <h2 class="h5 card-title">
                                {{ movie.title }}
                            </h2>

                            <p class="card-text text-muted">
                                Sorti en {{ movie.releaseDate|date('Y') }}
                            </p>

                            <p class="card-text">
                                {{ movie.synopsis|default('Aucun synopsis disponible.')|slice(0, 100) }}
                            </p>

                            <a
                                href="{{ path('app_movie_show', { id: movie.id }) }}"
                                class="btn btn-outline-primary mt-auto"
                            >
                                Voir la fiche
                            </a>
                        </div>
                    </article>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">
                        Aucun film n’est disponible pour le moment.
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}