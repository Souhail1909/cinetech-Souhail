{% extends 'base.html.twig' %}

{% block title %}Catalogue de films{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Catalogue de films</h1>

        {% if movies is empty %}
            <div class="alert alert-info">
                Aucun film n'est disponible pour le moment.
            </div>
        {% else %}
            <div class="row">
                {% for movie in movies %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                 style="height: 220px;">
                                <span class="text-white">Affiche indisponible</span>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">{{ movie.title }}</h5>

                                <p class="mb-2">
                                    <span class="badge bg-primary">
                                        {{ movie.category.name }}
                                    </span>
                                </p>

                                <p class="card-text mb-1">
                                    <strong>Date de sortie :</strong>
                                    {{ movie.releaseDate|date('d/m/Y') }}
                                </p>

                                <p class="card-text mb-1">
                                    <strong>Durée :</strong>
                                    {{ movie.duration }} minutes
                                </p>

                                {% if movie.synopsis %}
                                    <p class="card-text text-muted">
                                        {{ movie.synopsis|length > 150
                                            ? movie.synopsis|slice(0, 150) ~ '…'
                                            : movie.synopsis }}
                                    </p>
                                {% endif %}

                                <a href="{{ path('app_movie_show', { id: movie.id }) }}"
                                   class="btn btn-outline-primary mt-auto">
                                    Voir la fiche
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}